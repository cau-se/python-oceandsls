# Pylint configuration of the Python packages, used by the pylint job (.gitlab-ci.yml) and by make lint
[MAIN]
# Parsers, lexers, listeners and visitors generated by ANTLR
ignore-paths=^antlrLib/tests/gen/.*,
             .*lspserver/gen/.*
# The folders are not packages but contain them: each one is an import root (like the editable installs and the
# pytest pythonpath); nested roots come first (cp-dsl/test before cp-dsl)
source-roots=antlrLib,tdd-dsl,bgc-dsl,cp-dsl/test,cp-dsl,ci
jobs=0
persistent=no

[FORMAT]
max-line-length=120

[BASIC]
# Test classes and test methods need no docstrings
no-docstring-rgx=^_|^test_|^Test|^setUp|^tearDown
