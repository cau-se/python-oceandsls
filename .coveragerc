# Coverage of all Python packages: make coverage (pytest-cov), reported by the tests job in GitLab CI
[run]
branch = true
source_pkgs =
    odsllib
    codeCompletionCore
    tddlspserver
    bgclspserver
    cpdsl
    conflspserver
    dcllspserver
# Parsers, lexers and visitors generated by ANTLR
omit =
    */gen/*

[report]
skip_empty = true
precision = 1
